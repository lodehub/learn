{
  "about": "The language-neutral blueprint. Stages, sentence frames and word ids are the same for every language; each language file (french.json, mandarin.json, ...) only supplies translations. See README.md.",
  "levels": [
    { "id": 1, "title": "Starter pack", "blurb": "Ask questions, name things, say where they are, say what you want." },
    { "id": 2, "title": "Second pack", "blurb": "Talk about you: likes, things you have, colours, where you go." },
    { "id": 3, "title": "Grammar starts", "blurb": "Other people, yesterday and tomorrow, longer sentences." }
  ],
  "stages": [
    { "id": "ask", "level": 1, "n": 1, "emoji": "❓", "title": "Ask questions",
      "idea": "Questions come first. With eight question words you can find out almost anything, and the other person does most of the talking." },
    { "id": "name", "level": 1, "n": 2, "emoji": "🏷️", "title": "It's a…",
      "idea": "One sentence frame + any noun = a new sentence. It's a dog. It's a car. Is it a ball?" },
    { "id": "where", "level": 1, "n": 3, "emoji": "📍", "title": "Where is it?",
      "idea": "Little words like on, in and under let you place anything you can name." },
    { "id": "want", "level": 1, "n": 4, "emoji": "🙋", "title": "I want…",
      "idea": "The most useful sentence in any language. I want + a thing. I want to + an action." },
    { "id": "like", "level": 2, "n": 5, "emoji": "❤️", "title": "I like, I have",
      "idea": "Talk about yourself: what you like, what you don't, what you have." },
    { "id": "describe", "level": 2, "n": 6, "emoji": "🎨", "title": "Describe it",
      "idea": "Add colour and size to the things you already know. I see a blue car." },
    { "id": "do", "level": 2, "n": 7, "emoji": "🏃", "title": "Things I do",
      "idea": "Say what you do and where you go. I go to school. Every day, I swim." },
    { "id": "people", "level": 3, "n": 8, "emoji": "👪", "title": "He, she, we",
      "idea": "Swap I for other people. Same frames, new person at the front." },
    { "id": "time", "level": 3, "n": 9, "emoji": "⏰", "title": "Yesterday, tomorrow",
      "idea": "Same sentences, different time. Add yesterday or tomorrow and change one small thing." },
    { "id": "join", "level": 3, "n": 10, "emoji": "🔗", "title": "Join it up",
      "idea": "and, but, because turn two short sentences you already know into one long one." }
  ],

  "pools": {
    "thing": "thing", "animal": "animal", "spot": "furniture", "prep": "on / in / under",
    "food": "food", "drink": "drink", "fam": "family", "act": "action", "fun": "fun action",
    "daily": "action", "rest": "sleep / go home", "colour": "colour", "adj": "describing word",
    "place": "place", "who": "person"
  },

