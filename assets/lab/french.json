  "tips": {
    "ask": [
      "The easiest French question: say an ordinary sentence and let your voice go up at the end. C'est où ? = It's where?",
      "In everyday French the question word often goes at the end: Tu t'appelles comment ? C'est quand ?",
      "s'il te plaît is for a friend or family. Say s'il vous plaît to a grown-up you don't know."
    ],
    "name": [
      "Every French noun is masculine or feminine. Learn the little word with it: un chien, une voiture.",
      "ne … pas wraps around the verb like a sandwich: Ce n'est pas un chat."
    ],
    "where": [
      "The: le (masculine), la (feminine), l' (before a vowel sound), les (more than one).",
      "de + le squashes into du: à côté du lit. But à côté de la table."
    ],
    "want": [
      "Je veux + a thing, or Je veux + an action. The action stays in its dictionary form: Je veux manger.",
      "Some = du / de la / de l': du pain, de l'eau. For one thing, use un / une: une pomme.",
      "Politer version for shops and grown-ups: Je voudrais… (I would like…)."
    ],
    "like": [
      "French says 'the' when you mean things in general: J'aime les chats (I like cats).",
      "After a 'not', un / une turn into de: J'ai un chien → Je n'ai pas de chien.",
      "J'aime + an action works just like Je veux: J'aime nager."
    ],
    "describe": [
      "Colours go after the noun: une voiture rouge, un chat noir.",
      "Describing words match the noun. Feminine usually adds -e: le chat est petit, la voiture est petite."
    ],
    "do": [
      "à + le squashes into au: au parc. But à la plage, à l'école.",
      "The je form of most verbs ending in -er ends in -e: je joue, je nage, je chante.",
      "Je vais = I go. You'll use it again later for the future."
    ],
    "people": [
      "For most verbs, il / elle sounds exactly like je: je joue, il joue, elle joue.",
      "nous ends in -ons: nous jouons, nous nageons.",
      "A few verbs are special and worth learning by heart: il a, il veut, nous avons, nous voulons."
    ],
    "time": [
      "Past: j'ai + the past form (-é for -er verbs): j'ai joué, j'ai nagé.",
      "Going places uses je suis instead: je suis allé (a girl writes allée).",
      "Future: je vais + action. You already know both halves! Demain, je vais nager."
    ],
    "join": [
      "et = and, mais = but, parce que = because. Glue two sentences you already know.",
      "Feelings with avoir: j'ai faim (I have hunger), j'ai soif (I have thirst)."
    ]
  }
}
